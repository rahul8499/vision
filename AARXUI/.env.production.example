# Production-only Expo environment template.
# Current local .env and .env.example remain unchanged.

EXPO_PUBLIC_BASE_URL=https://<api-domain>
EXPO_PUBLIC_MSG91_WIDGET_ID=<msg91-widget-id>
EXPO_PUBLIC_MSG91_TOKEN_AUTH=<msg91-token-auth>
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=<google-web-client-id>
GOOGLE_MAPS_API_KEY=<android-google-maps-key>
