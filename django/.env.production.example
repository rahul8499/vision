# Production-only Django environment template.
# Copy to your server as .env.production or inject these through your secret manager.
# Do not use local/dev values here.

DJANGO_SETTINGS_MODULE=aarx.settings_production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=<generate-a-long-random-secret>
DJANGO_ALLOWED_HOSTS=<api.example.com>,<server-ip-if-needed>

DB_NAME=<database-name>
DB_USER=<database-user>
DB_PASSWORD=<database-password>
DB_HOST=<database-host-or-pgbouncer-host>
DB_PORT=<database-port>

REDIS_BROKER_URL=redis://<redis-host>:6379/0
REDIS_CHANNEL_URL=redis://<redis-host>:6379/0
REDIS_CACHE_URL=redis://<redis-host>:6379/1

CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOWED_ORIGINS=https://<support-web-domain>,https://<app-web-domain-if-any>
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
TRUST_X_FORWARDED_PROTO=true
API_NUM_PROXIES=<trusted-proxy-count>
API_RATE_LIMITING_ENABLED=true

SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05
PRODUCTION_SLOW_API_THRESHOLD_MS=1500
PRODUCTION_MONITORED_PATH_PREFIXES=/api/,/support-api/

GOOGLE_OAUTH_WEB_CLIENT_ID=
GOOGLE_PLACES_API_KEY=
MAPPLS_CLIENT_ID=
MAPPLS_CLIENT_SECRET=
MAPBOX_API_KEY=

EMAIL_HOST=<smtp-host>
EMAIL_PORT=587
EMAIL_HOST_USER=<smtp-user>
EMAIL_HOST_PASSWORD=<smtp-password>
DEFAULT_FROM_EMAIL=no-reply@<your-domain>

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
EMERGENCY_RAZORPAY_WEBHOOK_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=<private-media-bucket>
AWS_S3_REGION_NAME=<aws-region>
AWS_S3_ADDRESSING_STYLE=virtual
AWS_S3_PRESIGNED_URL_EXPIRY=3600

SUPPORT_ATTACHMENT_MALWARE_SCAN_REQUIRED=true
WHATSAPP_ENABLED=false
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_DEFAULT_COUNTRY_CODE=91
WHATSAPP_PASSWORD_RESET_TEMPLATE=
WHATSAPP_COMPLETION_OTP_TEMPLATE=
WHATSAPP_OTP_COPY_CODE_BUTTON=false
MSG91_AUTH_KEY=
MSG91_VERIFY_ACCESS_TOKEN_URL=https://control.msg91.com/api/v5/widget/verifyAccessToken
MSG91_HTTP_TIMEOUT_SECONDS=8
GOOGLE_LINK_TICKET_MAX_AGE_SECONDS=600
